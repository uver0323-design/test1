<!doctype html><html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#147447"><meta name="apple-mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-status-bar-style" content="default"><meta name="apple-mobile-web-app-title" content="家計簿"><link rel="manifest" href="manifest.webmanifest"><title>家計簿</title><style>
*{box-sizing:border-box}body{margin:0;background:#fff;color:#173b2c;font-family:system-ui,-apple-system,"Segoe UI",sans-serif}.app{max-width:760px;margin:auto;padding:18px 14px 92px}h1{margin:3px 0 14px;font-size:28px}h2{font-size:17px;margin:0 0 10px}.small{font-size:12px;color:#668071}.page{display:none}.page.on{display:block}.card{background:#effaf4;border:1px solid #d5ebdf;border-radius:18px;padding:15px;margin:10px 0}.white{background:#fff}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.num{font-size:20px;font-weight:850;margin-top:4px}.good{color:#087a47}.bad{color:#c34c4c}input,select,button{font:inherit}input,select{width:100%;padding:12px;margin:6px 0;border:1px solid #d6e6dd;border-radius:12px;background:white;color:#173b2c}button{cursor:pointer}.primary{width:100%;border:0;border-radius:12px;padding:12px;background:#147447;color:#fff;font-weight:800}.secondary{width:100%;border:1px solid #62a982;border-radius:12px;padding:11px;background:#edfaf3;color:#12643f;font-weight:800}.pay{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin:7px 0}.pay button{padding:11px;border:1px solid #bcd9c9;background:#fff;color:#426454;border-radius:12px;font-weight:800}.pay button.on{background:#147447;color:#fff;border-color:#147447}.row{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:10px 0;border-bottom:1px solid #dcece3}.actions{display:flex;gap:5px;align-items:center}.mini,.danger{width:auto;border:0;border-radius:9px;padding:6px 8px;font-size:12px;font-weight:800}.mini{background:#e5f7ed;color:#12643f}.danger{background:#fee2e2;color:#b91c1c}.nav{position:fixed;bottom:8px;left:50%;transform:translateX(-50%);width:calc(100% - 28px);max-width:730px;display:grid;grid-template-columns:repeat(4,1fr);gap:5px;background:#eff8f3;padding:5px;border-radius:15px;z-index:15}.nav button{border:0;background:transparent;color:#688174;border-radius:11px;padding:10px 2px;font-weight:800}.nav button.on{background:#198052;color:#fff}.modal{display:none;position:fixed;inset:0;background:rgba(20,55,40,.42);padding:18px;z-index:30;overflow:auto}.modal.on{display:flex;align-items:flex-start;justify-content:center}.modalbox{width:min(100%,520px);margin-top:20px;background:#fff;border-radius:20px;padding:17px;box-shadow:0 20px 50px #0003}.modalhead{display:flex;justify-content:space-between;align-items:center;gap:10px}.close{width:auto;border:0;border-radius:10px;background:#eaf5ef;color:#285b43;padding:7px 10px}.section{font-size:13px;font-weight:850;color:#147447;margin-top:14px}.alloc{display:grid;grid-template-columns:1fr 120px;gap:8px;align-items:center}.chartrow{display:grid;grid-template-columns:42px 1fr 2px 1fr 76px;gap:3px;align-items:center;min-height:36px}.monthbtn{width:auto;border:0;background:#e5f7ed;color:#12643f;border-radius:9px;padding:6px;font-weight:850}.left{display:flex;justify-content:flex-end}.right{display:flex}.ib{height:13px;background:#279b66;border-radius:7px 0 0 7px}.eb{height:13px;background:#86bfa0;border-radius:0 7px 7px 0}.axis{height:25px;background:#adcabb}.bal{text-align:right;font-size:12px;font-weight:800}.msg{font-size:12px;color:#087a47;min-height:18px;margin-top:6px}.file{display:block;text-align:center;background:#edfaf3;color:#12643f;border:1px solid #62a982;border-radius:12px;padding:11px;font-weight:800}.file input{display:none}@media(max-width:470px){.grid{grid-template-columns:1fr}.chartrow{grid-template-columns:38px 1fr 2px 1fr 68px}.alloc{grid-template-columns:1fr 112px}}
</style></head><body><div class="app"><div class="small">MY MONEY</div><h1>家計簿</h1>
<section id="daily" class="page on"><input id="date" type="date"><div class="card"><h2>支出を追加・編集</h2><input id="editId" type="hidden"><input id="amount" type="number" min="1" inputmode="numeric" placeholder="金額"><select id="category"><option>交通費</option><option>食費</option><option>趣味</option><option>家</option><option>智瀬</option><option>その他</option></select><div class="small">支払方法</div><div class="pay"><button type="button" class="on" data-pay="cash">現金</button><button type="button" data-pay="card">カード</button></div><div class="small">支払い元</div><select id="account"></select><input id="memo" maxlength="50" placeholder="メモ"><button id="saveTx" type="button" class="primary">保存</button><div id="dmsg" class="msg"></div></div><div class="card white"><h2>この日の明細</h2><div id="dailyList"></div></div></section>
<section id="monthly" class="page"><input id="month" type="month"><button id="openMonth" type="button" class="secondary">今月の数値を入力</button><div class="grid"><div class="card"><div class="small">収入</div><div id="mi" class="num">¥0</div></div><div class="card"><div class="small">支出</div><div id="me" class="num">¥0</div></div><div class="card"><div class="small">収支</div><div id="mb" class="num good">¥0</div></div></div><div class="card"><h2>口座残高</h2><div id="asset" class="num good"></div><div id="accountRows"></div></div><div class="card"><h2>月末確定</h2><div class="small">今月の収支残高</div><div id="available" class="num good">¥0</div><div class="small" style="margin-top:10px">各口座へ振り分ける額</div><div id="allocations"></div><div class="row"><span>振分合計</span><b id="allocTotal">¥0</b></div><div class="row"><span>残り</span><b id="allocRemain">¥0</b></div><button id="confirmMonth" type="button" class="primary">今月分を確定</button><div id="mmsg" class="msg"></div></div></section>
<section id="yearly" class="page"><div class="grid"><div class="card"><div class="small">額面給与合計</div><div id="grossTotal" class="num">¥0</div></div><div class="card"><div class="small">年間収入</div><div id="yearIncome" class="num">¥0</div></div><div class="card"><div class="small">年間収支</div><div id="yearBalance" class="num good">¥0</div></div></div><div class="card"><h2>月別収支</h2><div class="small">収入 ←　中央　→ 支出</div><div id="yearChart"></div><div class="small" style="margin-top:10px">月を押すと、その月の詳細へ移動します。</div></div></section>
<section id="settings" class="page"><div class="card"><h2>口座を追加</h2><input id="newName" placeholder="口座名"><input id="newBalance" type="number" min="0" placeholder="現在残高"><button id="addAccount" type="button" class="primary">口座を追加</button></div><div class="card"><h2>データ</h2><label class="file">非公開JSONを読み込む<input id="importFile" type="file" accept="application/json,.json"></label><button id="exportData" type="button" class="secondary" style="margin-top:8px">現在のデータを書き出す</button><div id="dataMsg" class="msg"></div></div></section></div>
<nav class="nav"><button type="button" class="on" data-page="daily">毎日</button><button type="button" data-page="monthly">月間</button><button type="button" data-page="yearly">年間</button><button type="button" data-page="settings">設定</button></nav>
<div id="monthModal" class="modal" role="dialog" aria-modal="true"><div class="modalbox"><div class="modalhead"><h2>今月の数値</h2><button id="closeModal" type="button" class="close">閉じる</button></div><div class="section">収入</div><div class="small">額面給与</div><input id="gross" type="number" min="0"><div class="small">給与（手取り）</div><input id="net" type="number" min="0"><div class="small">その他収入</div><input id="otherIncome" type="number" min="0"><div class="section">変動費</div><div class="small">水道代</div><input id="water" type="number" min="0"><div class="small">電気代</div><input id="electric" type="number" min="0"><div class="small">その他変動費</div><input id="variable" type="number" min="0"><div class="section">固定費・積立</div><div class="small">家賃（ローン）</div><input id="rent" type="number" min="0"><div class="small">積立NISA</div><input id="nisa" type="number" min="0"><button id="saveMonth" type="button" class="primary">この月を保存</button></div></div>
<script>(function(){'use strict';var D=document,q=function(s){return D.querySelector(s)},KEY='kakeibo_final_v1';var empty={version:1,accounts:[],tx:[],months:{},closed:{}};var state=JSON.parse(JSON.stringify(empty)),pay='cash';try{var saved=JSON.parse(localStorage.getItem(KEY)||'null');if(saved)state=normalize(saved)}catch(e){}function normalize(v){return{version:1,accounts:Array.isArray(v.accounts)?v.accounts:[],tx:Array.isArray(v.tx)?v.tx:[],months:v.months&&typeof v.months==='object'?v.months:{},closed:v.closed&&typeof v.closed==='object'?v.closed:{}}}function today(){var d=new Date();return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0')}function yen(n){n=Math.round(Number(n)||0);return(n<0?'-':'')+'¥'+Math.abs(n).toLocaleString('ja-JP')}function val(id){var n=Number(q(id).value);return Number.isFinite(n)&&n>=0?Math.round(n):0}function save(){try{localStorage.setItem(KEY,JSON.stringify(state));return true}catch(e){return false}}function monthSpend(m){return state.tx.filter(function(x){return x.date&&x.date.slice(0,7)===m}).reduce(function(s,x){return s+(Number(x.amount)||0)},0)}function recurring(x){return(Number(x.water)||0)+(Number(x.electric)||0)+(Number(x.variable)||0)+(Number(x.rent)||0)+(Number(x.nisa)||0)}function income(x){return(Number(x.net)||0)+(Number(x.otherIncome)||0)}function go(id){D.querySelectorAll('.page,.nav button').forEach(function(x){x.classList.remove('on')});q('#'+id).classList.add('on');var b=D.querySelector('.nav button[data-page="'+id+'"]');if(b)b.classList.add('on')}function fillAccounts(){var s=q('#account'),old=s.value;s.innerHTML='';state.accounts.forEach(function(a){var o=D.createElement('option');o.value=a.id;o.textContent=a.name;s.append(o)});if(state.accounts.some(function(a){return a.id===old}))s.value=old}function buildAlloc(){var box=q('#allocations');box.innerHTML='';state.accounts.forEach(function(a){var d=D.createElement('div');d.className='alloc';var l=D.createElement('span'),i=D.createElement('input');l.textContent=a.name;i.type='number';i.min='0';i.inputMode='numeric';i.placeholder='振分額';i.dataset.id=a.id;i.oninput=allocTotals;d.append(l,i);box.append(d)})}function allocTotals(){var m=q('#month').value,x=state.months[m]||{},available=Math.max(0,income(x)-recurring(x)-monthSpend(m)),total=0;D.querySelectorAll('#allocations input').forEach(function(i){total+=Math.max(0,Math.round(Number(i.value)||0))});q('#allocTotal').textContent=yen(total);q('#allocRemain').textContent=yen(available-total);q('#allocRemain').className=available-total>=0?'good':'bad'}function render(){fillAccounts();var d=q('#date').value,m=q('#month').value,x=state.months[m]||{},inc=income(x),out=recurring(x)+monthSpend(m),bal=inc-out;q('#mi').textContent=yen(inc);q('#me').textContent=yen(out);q('#mb').textContent=yen(bal);q('#mb').className='num '+(bal>=0?'good':'bad');q('#available').textContent=yen(Math.max(0,bal));q('#asset').textContent='総資産 '+yen(state.accounts.reduce(function(s,a){return s+(Number(a.balance)||0)},0));var ar=q('#accountRows');ar.innerHTML='';state.accounts.forEach(function(a){var r=D.createElement('div');r.className='row';var n=D.createElement('span'),b=D.createElement('b');n.textContent=a.name;b.textContent=yen(a.balance);r.append(n,b);ar.append(r)});var daily=state.tx.filter(function(t){return t.date===d}),list=q('#dailyList');list.innerHTML='';if(!daily.length)list.innerHTML='<div class="small">明細はありません</div>';daily.forEach(function(t){var a=state.accounts.find(function(v){return v.id===t.account}),r=D.createElement('div');r.className='row';var left=D.createElement('span'),act=D.createElement('div'),amt=D.createElement('b'),edit=D.createElement('button'),del=D.createElement('button');act.className='actions';left.textContent=(t.memo||t.category)+' · '+(a?a.name:'');amt.textContent=yen(t.amount);edit.type='button';edit.className='mini';edit.textContent='編集';edit.onclick=function(){q('#editId').value=String(t.id);q('#amount').value=t.amount;q('#category').value=t.category;q('#account').value=t.account;q('#memo').value=t.memo||'';pay=t.payment||'cash';D.querySelectorAll('.pay button').forEach(function(b){b.classList.toggle('on',b.dataset.pay===pay)})};del.type='button';del.className='danger';del.textContent='削除';del.onclick=function(){if(confirm('この明細を削除しますか？')){var ac=state.accounts.find(function(v){return v.id===t.account});if(ac)ac.balance+=t.amount;state.tx=state.tx.filter(function(x){return x.id!==t.id});save();render()}};act.append(amt,edit,del);r.append(left,act);list.append(r)});buildAlloc();allocTotals();buildYear()}function buildYear(){var gross=0,inc=0,out=0,max=1,data=[];Object.keys(state.months).sort().forEach(function(k){var x=state.months[k],i=income(x),e=recurring(x)+monthSpend(k),b=i-e;gross+=Number(x.gross)||0;inc+=i;out+=e;max=Math.max(max,i,e);data.push({k:k,i:i,e:e,b:b})});q('#grossTotal').textContent=yen(gross);q('#yearIncome').textContent=yen(inc);q('#yearBalance').textContent=yen(inc-out);q('#yearBalance').className='num '+(inc-out>=0?'good':'bad');var box=q('#yearChart');box.innerHTML='';data.forEach(function(x){var row=D.createElement('div');row.className='chartrow';var mo=D.createElement('button');mo.type='button';mo.className='monthbtn';mo.textContent=Number(x.k.slice(5))+'月';mo.onclick=function(){q('#month').value=x.k;go('monthly');render()};var left=D.createElement('div');left.className='left';var ib=D.createElement('div');ib.className='ib';ib.style.width=(x.i/max*100)+'%';left.append(ib);var axis=D.createElement('div');axis.className='axis';var right=D.createElement('div');right.className='right';var eb=D.createElement('div');eb.className='eb';eb.style.width=(x.e/max*100)+'%';right.append(eb);var b=D.createElement('div');b.className='bal '+(x.b>=0?'good':'bad');b.textContent=yen(x.b);row.append(mo,left,axis,right,b);box.append(row)})}q('#date').value=today();q('#month').value=today().slice(0,7);q('#date').onchange=render;q('#month').onchange=render;D.querySelectorAll('.pay button').forEach(function(b){b.onclick=function(){D.querySelectorAll('.pay button').forEach(function(x){x.classList.remove('on')});b.classList.add('on');pay=b.dataset.pay}});q('#saveTx').onclick=function(){var amount=val('#amount'),date=q('#date').value,id=q('#editId').value,a=state.accounts.find(function(x){return x.id===q('#account').value});if(!amount||!date||!a){q('#dmsg').textContent='金額と支払い元を確認してください';return}var obj={date:date,amount:amount,category:q('#category').value,payment:pay,account:a.id,memo:q('#memo').value.trim()};if(id){var old=state.tx.find(function(x){return String(x.id)===id});if(old){var oldA=state.accounts.find(function(x){return x.id===old.account});if(oldA)oldA.balance+=old.amount;a.balance-=amount;Object.assign(old,obj)}}else{a.balance-=amount;obj.id=Date.now();state.tx.push(obj)}q('#editId').value='';q('#amount').value='';q('#memo').value='';q('#dmsg').textContent='保存しました';save();render()};q('#openMonth').onclick=function(){var x=state.months[q('#month').value]||{};[['gross','gross'],['net','net'],['otherIncome','otherIncome'],['water','water'],['electric','electric'],['variable','variable'],['rent','rent'],['nisa','nisa']].forEach(function(a){q('#'+a[0]).value=x[a[1]]||''});q('#monthModal').classList.add('on')};q('#closeModal').onclick=function(){q('#monthModal').classList.remove('on')};q('#saveMonth').onclick=function(){state.months[q('#month').value]={gross:val('#gross'),net:val('#net'),otherIncome:val('#otherIncome'),water:val('#water'),electric:val('#electric'),variable:val('#variable'),rent:val('#rent'),nisa:val('#nisa')};save();q('#monthModal').classList.remove('on');render()};q('#confirmMonth').onclick=function(){var m=q('#month').value,x=state.months[m]||{},available=Math.max(0,income(x)-recurring(x)-monthSpend(m));if(state.closed[m]){q('#mmsg').textContent='この月は確定済みです';return}var total=0,alloc={};D.querySelectorAll('#allocations input').forEach(function(i){var v=Math.max(0,Math.round(Number(i.value)||0));alloc[i.dataset.id]=v;total+=v});if(total>available){q('#mmsg').textContent='振分合計が収支残高を超えています';return}state.accounts.forEach(function(a){a.balance+=alloc[a.id]||0});state.closed[m]={allocations:alloc,total:total,carry:available-total};q('#mmsg').textContent='今月分を確定しました。現在残高を翌月へ繰り越します';save();render()};q('#addAccount').onclick=function(){var name=q('#newName').value.trim(),balance=val('#newBalance');if(!name)return;state.accounts.push({id:'a'+Date.now(),name:name,balance:balance});q('#newName').value='';q('#newBalance').value='';save();render()};q('#importFile').onchange=function(ev){var f=ev.target.files&&ev.target.files[0];if(!f)return;var reader=new FileReader();reader.onload=function(){try{state=normalize(JSON.parse(reader.result));save();q('#dataMsg').textContent='データを読み込みました';render()}catch(e){q('#dataMsg').textContent='JSONを読み込めませんでした'}};reader.readAsText(f,'utf-8');ev.target.value=''};q('#exportData').onclick=function(){var blob=new Blob([JSON.stringify(state,null,2)],{type:'application/json'}),url=URL.createObjectURL(blob),a=D.createElement('a');a.href=url;a.download='kakeibo-private-data.json';D.body.appendChild(a);a.click();a.remove();setTimeout(function(){URL.revokeObjectURL(url)},500)};D.querySelectorAll('.nav button').forEach(function(b){b.onclick=function(){go(b.dataset.page)}});render()})();</script></body></html>

